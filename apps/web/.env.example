DATABASE_URL=postgres://postgres:postgres@localhost:5433/aeo
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
APP_NAME=AEO Service Console
APP_ICON=/icons/aeo-icon.svg
APP_URL=http://localhost:3000
